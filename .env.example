# =============================================================
# Velas Reny - Variables de entorno
# Copia este archivo a `.env.local` y rellena los valores reales.
# NUNCA subas `.env.local` al repositorio (ya está en .gitignore).
# NUNCA pongas la `service_role key` en variables NEXT_PUBLIC_*.
# =============================================================

# URL de tu proyecto Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=

# Clave "anon" (pública) de Supabase. Es segura para el navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
